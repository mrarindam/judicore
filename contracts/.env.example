# Wallet private key (with 0x prefix) - DO NOT COMMIT
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Somnia testnet RPC (default is baked into hardhat.config.ts)
SOMNIA_TESTNET_RPC=https://dream-rpc.somnia.network

# Deposit buffer multiplier - send N times the recommended msg.value to handle
# tool-call overhead inside inferToolsChat (default 1.5)
SOMNIA_DEPOSIT_BUFFER=1.5

# Agent IDs (filled in after first testnet deployment & agent discovery)
LLM_INFERENCE_AGENT_ID=
JSON_API_AGENT_ID=
LLM_PARSE_WEBSITE_AGENT_ID=
